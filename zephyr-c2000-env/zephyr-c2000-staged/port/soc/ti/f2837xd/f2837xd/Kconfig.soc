config SOC_SERIES_F2837XD
	bool
	select SOC_FAMILY_TI_F2837XD

config SOC_SERIES
	default "f2837xd" if SOC_SERIES_F2837XD

config SOC_TI_F2837XD
	bool
	select SOC_SERIES_F2837XD
	select C2000
	select BUILD_OUTPUT_HEX
	help
	  TI TMS320F2837xD dual-core C28x MCU (200 MHz, 1 MB flash,
	  204 KB RAM per core, FPU32, TMU).

config SOC
	default "ti_f2837xd" if SOC_TI_F2837XD
